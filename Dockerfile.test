# =============================================================================
# 测试环境镜像：安装锁定依赖并复制源码，不启用 PyArmor / 授权烧录
# 构建：
#   docker build -f Dockerfile.test -t complaint-dedup-validator-intranet:latest .
# 说明：
#   - 生产/内网正式交付请使用 Dockerfile.intranet（含 PyArmor 与到期日烧录）；
#   - 本文件仅用于开发/测试环境快速构建。
# =============================================================================
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /uvx /bin/

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONPATH=/app/src

WORKDIR /build

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
    && mkdir -p /app/runtime \
    && chown app:app /app/runtime

WORKDIR /app

COPY src /app/src
COPY templates /app/templates
COPY static /app/static
COPY alembic /app/alembic
COPY alembic.ini /app/alembic.ini

USER app

EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/healthz', timeout=5)"]

CMD ["uvicorn", "complaint_dedup.main:app", "--host", "0.0.0.0", "--port", "8765"]
