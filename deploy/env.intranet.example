# =============================================================================
# 投诉全量工单比对系统 - 内网 Docker 部署配置模板
# 使用方法：复制到项目根目录 config/.env，仅填写模型连接信息。
# PostgreSQL 地址、账号、密码、数据库名、端口均由 compose.intranet.yaml 管理。
# =============================================================================

# --------------------------- OpenAI 兼容模型服务 ----------------------------
# 内网模型服务地址，必须包含 /v1。例如：http://模型服务器IP:8000/v1。
LLM_BASE_URL=http://192.168.16.90:8000/v1
# 模型访问密钥。内网 vLLM 等服务不校验时填写 EMPTY。
LLM_API_KEY=EMPTY
# 模型名称，必须与内网模型服务实际暴露的名称完全一致。
LLM_MODEL=Qwen3-32B
# 模型请求并发数。本地部署建议 16；显存或吞吐不足时下调至 8。
LLM_CONCURRENCY=16
# 单次模型 HTTP 请求超时时间，单位秒。本地大模型建议 200。
LLM_TIMEOUT_SECONDS=200
# 单次请求失败后的最大尝试次数（含首次），失败会重试并修复无效 JSON。
LLM_MAX_RETRIES=3
# 判重要求结果稳定，温度建议保持 0。
LLM_TEMPERATURE=0
# 单次模型响应最大生成 token 数。
LLM_MAX_TOKENS=4096
# 是否允许模型进行思考模式推理；判重模型建议 false。
LLM_ENABLE_THINKING=false
# 是否发送 enable_thinking 字段；模型服务不支持时设为 false。
LLM_SEND_ENABLE_THINKING=false
# JSON 输出模式：prompt=仅靠提示词；json_object=OpenAI response_format；
# guided_json=vLLM/SGLang 结构化解码。模型服务支持时优先 guided_json 以降低无效 JSON。
LLM_JSON_MODE=prompt

# ----------------------------- 自动判重参数 ---------------------------------
# 是否启用事件卡 LLM 判重。关闭后仅使用硬匹配和保守规则。
DEDUP_LLM_ENABLED=true
# 每张事件卡最多保留的候选数量。
DEDUP_MAX_CANDIDATES=30
# 每次发送给模型的代表事件卡数量，建议 8-16；模型上下文充足时可提高到 24。
DEDUP_CARDS_PER_BATCH=16
# 单次比对最大模型请求数；0 表示不限制，适合本地模型。
DEDUP_MAX_REQUESTS=0
# 自动判重模型并发数。本地部署建议 16；显存或吞吐不足时下调至 8。
DEDUP_MAX_CONCURRENCY=16
# 单次比对模型总时长上限，单位秒；0 表示不限制。
DEDUP_MAX_SECONDS=0
# 模型自动合并的最低置信度。提高会更保守，降低会合并更多灰区工单。
DEDUP_MIN_CONFIDENCE=0.7
# 高相似文本确定性合并开关：正文归一化后相似度达到阈值且无硬冲突时直接合并。
DEDUP_TEXT_DUPLICATE_ENABLED=true
# 高相似文本合并阈值，取值 0-1；默认 0.9。
DEDUP_TEXT_DUPLICATE_THRESHOLD=0.9
# 回退合并时间跨度护栏：回退合并跨度超过该天数时要求强证据；0 表示关闭。
DEDUP_FALLBACK_MAX_SPAN_DAYS=90
# 时间跨度护栏影子模式：true=只统计不生效；观察确认后再设为 false 启用。
DEDUP_FALLBACK_SPAN_SHADOW=true

# --------------------------- HTTP 连接池参数 --------------------------------
# 最大 HTTP 连接数，应大于或等于 DEDUP_MAX_CONCURRENCY。
HTTP_MAX_CONNECTIONS=32
# 长连接保留数，不能大于 HTTP_MAX_CONNECTIONS。
HTTP_MAX_KEEPALIVE_CONNECTIONS=16

# 说明：
# 1. 设置为 DEDUP_MAX_REQUESTS=0、DEDUP_MAX_SECONDS=0 时，未处理的工单不会
#    被直接丢弃；模型异常或显式预算耗尽时，仍会回退硬匹配和现行保守规则。
# 2. 修改模型地址、模型名或并发后，执行：
#    docker compose --project-directory . -f deploy/compose.intranet.yaml up -d
