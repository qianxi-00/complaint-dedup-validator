# ============================================================
# 内网部署环境配置模板 —— 复制到服务器 config/.env 后按需修改
# 注意:只保留当前源码实际生效或为后续外部模型扩展保留的变量
# ============================================================

# ----- Web 服务 -----
APP_HOST=0.0.0.0
APP_PORT=8765
APP_TIMEZONE=Asia/Shanghai

# ----- 数据库(内置 PostgreSQL 容器) -----
DATABASE_MODE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=请修改为强密码
DB_NAME=gongdan
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# 供内置 postgres 容器初始化使用(必须与上方 DB_USER/DB_PASSWORD/DB_NAME 保持一致)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=请修改为强密码
POSTGRES_DB=gongdan

# ----- 容量 -----
MAX_TOTAL_ROWS=200000

# ----- 日志 -----
LOG_LEVEL=INFO
LOG_DIR=runtime/logs
LOG_RETENTION_DAYS=30

# ----- 归一化 -----

# ----- 内网大模型(vLLM 等 OpenAI 兼容服务) -----
# 改为内网推理机地址;若推理框架不支持 enable_thinking 字段,保持 LLM_SEND_ENABLE_THINKING=false
# LLM_CONCURRENCY 为全局 LLM 并发,后续吞吐不足时可调大,无需改代码
LLM_BASE_URL=http://192.168.16.90:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen3-32B
LLM_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_ENABLE_THINKING=false
LLM_SEND_ENABLE_THINKING=false

# ----- HTTP 连接池 -----
HTTP_MAX_CONNECTIONS=24
HTTP_MAX_KEEPALIVE_CONNECTIONS=12
