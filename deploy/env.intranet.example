# 内网部署模型配置模板 —— 复制到服务器 config/.env 后按需修改
# 数据库连接、表初始化、端口和运行参数由 Docker Compose 自动管理

# ----- 内网大模型（OpenAI 兼容服务） -----
# 当前确定性判重主流程不调用模型，以下配置为后续模型扩展预留。
LLM_BASE_URL=http://192.168.16.90:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen3-32B
LLM_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_ENABLE_THINKING=false
LLM_SEND_ENABLE_THINKING=false
