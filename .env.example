# =============================================================================
# 投诉全量工单比对系统 - 本地开发环境配置模板
# 复制为 .env 后按需修改；包含真实密码和密钥的文件不得提交到 Git。
# =============================================================================

# ------------------------------- 服务运行参数 -------------------------------
# API 监听地址。本机开发使用 127.0.0.1；容器部署由 Compose 覆盖为 0.0.0.0。
APP_HOST=127.0.0.1
# API 对外端口。Docker 内网部署默认映射宿主机 28765 到容器 8765。
APP_PORT=8765
# 业务时区，办结日期、任务时间和授权日期均按此自然日计算。
APP_TIMEZONE=Asia/Shanghai

# ------------------------------- 数据库配置 ---------------------------------
# 数据库类型：本地开发使用 sqlite；正式部署使用 postgresql。
DATABASE_MODE=sqlite
# SQLite 数据库文件路径；仅 DATABASE_MODE=sqlite 时生效。
DATABASE_PATH=runtime/app.db
# PostgreSQL 地址；仅 DATABASE_MODE=postgresql 时生效。
DB_HOST=127.0.0.1
# PostgreSQL 端口。
DB_PORT=5432
# PostgreSQL 用户名。Docker 内网部署由 Compose 固定管理。
DB_USER=postgres
# PostgreSQL 密码。请只写入 .env 或服务器 config/.env，不要提交到 Git。
DB_PASSWORD=
# PostgreSQL 数据库名。
DB_NAME=gongdan
# PostgreSQL 常驻连接池大小。本地开发通常保持默认即可。
DB_POOL_SIZE=10
# PostgreSQL 连接池允许的临时溢出连接数。
DB_MAX_OVERFLOW=10

# ------------------------------- 导入与日志 ---------------------------------
# 单次全量 Excel 允许的最大数据行数，防止误传超大文件耗尽内存。
MAX_TOTAL_ROWS=200000
# 日志级别：DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO
# 日志文件目录。
LOG_DIR=runtime/logs
# 日志文件保留天数，超期文件由程序自动清理。
LOG_RETENTION_DAYS=30

# --------------------------- HTTP 连接池与模型并发 ---------------------------
# 对外 HTTP 最大连接数。模型并发提高时，程序会自动扩展连接池。
HTTP_MAX_CONNECTIONS=24
# 对外 HTTP 长连接保留数，不能大于 HTTP_MAX_CONNECTIONS。
HTTP_MAX_KEEPALIVE_CONNECTIONS=12

# --------------------------- OpenAI 兼容模型服务 ----------------------------
# 模型服务地址，必须包含 OpenAI 兼容的 /v1 前缀。
# 本地测试先用外部 API；内网部署时改为本地模型地址（如 http://模型服务器IP:8000/v1）。
LLM_BASE_URL=https://api.siliconflow.cn/v1
# 模型访问密钥。内网 vLLM 等服务不校验时可填写 EMPTY。
LLM_API_KEY=
# 用于事件卡判重的模型名称，必须与模型服务实际暴露的名称完全一致。
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 模型请求并发数。外部 API 限流较严时下调（建议 4-8）；本地部署可提高到 16。
LLM_CONCURRENCY=4
# 单次模型 HTTP 请求超时时间，单位秒。本地模型响应慢时建议 200。
LLM_TIMEOUT_SECONDS=200
# 单次模型请求失败后的最大尝试次数（含首次），失败会重试并修复无效 JSON。
LLM_MAX_RETRIES=3
# 模型温度。判重要求稳定，建议保持 0。
LLM_TEMPERATURE=0
# 单次模型响应最大生成 token 数。事件卡批量较大时可适当提高。
LLM_MAX_TOKENS=4096
# 是否允许模型进行思考模式推理；普通判重模型建议 false。
LLM_ENABLE_THINKING=false
# 是否向模型服务发送 enable_thinking 字段；部分 OpenAI 兼容服务不支持时设为 false。
LLM_SEND_ENABLE_THINKING=true
# JSON 输出模式：prompt=仅靠提示词；json_object=OpenAI response_format；
# guided_json=vLLM/SGLang 结构化解码。服务不支持时保持 prompt。
LLM_JSON_MODE=prompt

# ----------------------------- 自动判重参数 ---------------------------------
# 是否启用事件卡 LLM 判重。关闭后仅使用硬匹配和保守规则。
DEDUP_LLM_ENABLED=true
# 每张事件卡最多保留的候选数量，用于控制候选召回规模。
DEDUP_MAX_CANDIDATES=30
# 每次发送给模型的代表事件卡数量，建议 8-16，最大不超过 32。
DEDUP_CARDS_PER_BATCH=16
# 单次比对最多发起的模型请求数；0 表示不限制（外部 API 建议先设为 0 观察限流）。
DEDUP_MAX_REQUESTS=0
# 自动判重模型并发数。worker 实际使用该值；外部 API 限流时下调（建议 4-8）。
DEDUP_MAX_CONCURRENCY=4
# 单次比对允许消耗的模型总时长，单位秒；0 表示不限制。
DEDUP_MAX_SECONDS=0
# 模型自动合并的最低置信度。提高会更保守，降低会合并更多灰区工单。
DEDUP_MIN_CONFIDENCE=0.7
# 高相似文本确定性合并开关：正文归一化后相似度达到阈值且无硬冲突时直接合并。
DEDUP_TEXT_DUPLICATE_ENABLED=true
# 高相似文本合并阈值，取值 0-1；默认 0.9。
DEDUP_TEXT_DUPLICATE_THRESHOLD=0.9
# 回退合并时间跨度护栏：回退合并跨度超过该天数时要求强证据；0 表示关闭。
DEDUP_FALLBACK_MAX_SPAN_DAYS=90
# 时间跨度护栏影子模式：true=只统计不生效；观察确认后再设为 false 启用。
DEDUP_FALLBACK_SPAN_SHADOW=true

# 本地模型无限处理示例（并发按本地资源调整，外部 API 请谨慎放开）：
# LLM_CONCURRENCY=16
# DEDUP_MAX_CONCURRENCY=16
# DEDUP_MAX_REQUESTS=0
# DEDUP_MAX_SECONDS=0
# HTTP_MAX_CONNECTIONS=32
# HTTP_MAX_KEEPALIVE_CONNECTIONS=16
