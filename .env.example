# =============================================================================
# 投诉全量工单比对系统 - 本地开发环境配置模板
# 复制为 .env 后按需修改；包含真实密码和密钥的文件不得提交到 Git。
# 运行时统一使用 PostgreSQL（阿里云百炼模型服务）；SQLite 仅用于单元测试。
# =============================================================================

# ------------------------------- 服务运行参数 -------------------------------
# API 监听地址。本机开发使用 127.0.0.1；容器部署由 Compose 覆盖为 0.0.0.0。
APP_HOST=127.0.0.1
# API 对外端口。Docker 内网部署默认映射宿主机 28765 到容器 8765。
APP_PORT=8765
# 业务时区，办结日期、任务时间和授权日期均按此自然日计算。
APP_TIMEZONE=Asia/Shanghai

# ------------------------------- 数据库配置 ---------------------------------
# 数据库类型：固定 postgresql。
DATABASE_MODE=postgresql
# PostgreSQL 地址。
DB_HOST=192.168.16.90
# PostgreSQL 端口。
DB_PORT=5432
# PostgreSQL 用户名。
DB_USER=postgres
# PostgreSQL 密码。请只写入 .env 或服务器 config/.env，不要提交到 Git。
DB_PASSWORD=
# PostgreSQL 数据库名。
DB_NAME=gongdan
# PostgreSQL 常驻连接池大小。
DB_POOL_SIZE=10
# PostgreSQL 连接池允许的临时溢出连接数。
DB_MAX_OVERFLOW=10

# ------------------------------- 导入与日志 ---------------------------------
# 单次全量 Excel 允许的最大数据行数，防止误传超大文件耗尽内存。
MAX_TOTAL_ROWS=200000
# 日志级别：DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO
# 日志文件目录。
LOG_DIR=runtime/logs
# 日志文件保留天数，超期文件由程序自动清理。
LOG_RETENTION_DAYS=30

# --------------------------- HTTP 连接池与模型并发 ---------------------------
# 对外 HTTP 最大连接数。模型并发提高时，程序会自动扩展连接池。
HTTP_MAX_CONNECTIONS=32
# 对外 HTTP 长连接保留数，不能大于 HTTP_MAX_CONNECTIONS。
HTTP_MAX_KEEPALIVE_CONNECTIONS=16

# --------------------------- OpenAI 兼容模型服务 ----------------------------
# 模型服务地址：阿里云百炼 OpenAI 兼容模式。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型访问密钥（阿里云百炼控制台申请）。
LLM_API_KEY=
# 事件卡判重模型名称。
LLM_MODEL=qwen3.7-flash
# 模型请求并发数。
LLM_CONCURRENCY=8
# 单次模型 HTTP 请求超时时间，单位秒。
LLM_TIMEOUT_SECONDS=200
# 单次模型请求失败后的最大尝试次数（含首次），失败会重试并修复无效 JSON。
LLM_MAX_RETRIES=3
# 模型温度。判重要求稳定，建议保持 0。
LLM_TEMPERATURE=0
# 单次模型响应最大生成 token 数。
LLM_MAX_TOKENS=4096
# 是否允许模型进行思考模式推理；判重模型建议 false。
LLM_ENABLE_THINKING=false
# 是否向模型服务发送 enable_thinking 字段；服务不支持时设为 false。
LLM_SEND_ENABLE_THINKING=true
# JSON 输出模式：prompt=仅靠提示词；json_object=OpenAI response_format；
# guided_json=vLLM/SGLang 结构化解码。百炼保持 prompt 即可。
LLM_JSON_MODE=prompt

# ----------------------------- 自动判重参数 ---------------------------------
# 是否启用事件卡 LLM 判重。关闭后仅使用硬匹配和保守规则。
DEDUP_LLM_ENABLED=true
# 每张事件卡最多保留的候选数量，用于控制候选召回规模。
DEDUP_MAX_CANDIDATES=30
# 每次发送给模型的代表事件卡数量，建议 8-16，最大不超过 32。
DEDUP_CARDS_PER_BATCH=16
# 单次比对最多发起的模型请求数；0 表示不限制。
DEDUP_MAX_REQUESTS=0
# 自动判重模型并发数；worker 实际使用该值。
DEDUP_MAX_CONCURRENCY=8
# 单次比对允许消耗的模型总时长，单位秒；0 表示不限制。
DEDUP_MAX_SECONDS=0
# 模型自动合并的最低置信度。提高会更保守，降低会合并更多灰区工单。
DEDUP_MIN_CONFIDENCE=0.7
# 高相似文本确定性合并开关：正文归一化后相似度达到阈值且无硬冲突时直接合并。
DEDUP_TEXT_DUPLICATE_ENABLED=true
# 高相似文本合并阈值，取值 0-1。
DEDUP_TEXT_DUPLICATE_THRESHOLD=0.9
# 回退合并时间跨度护栏：回退合并跨度超过该天数时要求强证据；0 表示关闭。
DEDUP_FALLBACK_MAX_SPAN_DAYS=90
# 时间跨度护栏影子模式：false=生效（默认）；true=只统计不生效。
DEDUP_FALLBACK_SPAN_SHADOW=false
